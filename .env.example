# Public settings for the Microsoft Entra SPA app registration.
# These identifiers are embedded in the client bundle; never put secrets here.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=

# The browser requests this delegated scope only when the player opens the leaderboard.
# It is derived from VITE_ENTRA_CLIENT_ID; configure leaderboard.access on the Entra app registration.
