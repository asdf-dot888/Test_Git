{
  "name": "board-card-roguelike",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/leaderboard-api",
    "packages/game-core"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @board-game/web",
    "deploy:swa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-static-web-app.ps1",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "build": "npm run build --workspace @board-game/game-core && npm run build --workspace @board-game/api && npm run build --workspace @board-game/leaderboard-api && npm run build --workspace @board-game/web",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "npm run start --workspace @board-game/api"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
