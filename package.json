{
  "name": "board-card-roguelike",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/game-core"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:azure": "concurrently -k -n api,web \"npm run dev --workspace @board-game/api\" \"npm run dev --workspace @board-game/web\"",
    "build": "npm run build --workspace @board-game/game-core && npm run build --workspace @board-game/api && npm run build --workspace @board-game/web",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "npm run start --workspace @board-game/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
